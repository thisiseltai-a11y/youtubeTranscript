# Required for the "Rewrite with Claude" feature.
ANTHROPIC_API_KEY=

# Optional. Enables the Whisper fallback for videos with no captions, or
# only low-quality auto-generated ones. Without this, the tool still works
# but falls back to YouTube's auto-captions (or errors) when there's no
# human-made caption track.
OPENAI_API_KEY=

# Optional, for the deployed (Vercel) version only. Set automatically when
# you add the "Upstash for Redis" integration from the Vercel Marketplace -
# gives the transcript cache durable, shared storage instead of the
# per-invocation /tmp fallback. Not needed for local dev (uses ./cache).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional. Base64-encoded Netscape-format cookies.txt from a logged-in
# YouTube browser session. YouTube sometimes blocks/rate-limits requests
# from cloud IPs (including Vercel's) - cookies are the standard workaround
# for one server / low volume. See README for how to generate this.
# YTDLP_COOKIES_B64=

# Optional, and the scalable fix for cloud-IP blocking (unlike the two
# above, which are tied to one identity): Webshare rotating residential
# proxy credentials, from https://dashboard.webshare.io/proxy/settings
# after buying a "Residential" package (NOT "Proxy Server" or "Static
# Residential"). Both values are required together. See README.
# WEBSHARE_PROXY_USERNAME=
# WEBSHARE_PROXY_PASSWORD=
# WEBSHARE_PROXY_LOCATIONS=   # optional, e.g. "US,CA"

# Optional overrides - defaults shown.
# REWRITE_MODEL=claude-opus-5
# WHISPER_MODEL=whisper-1
# MAX_VIDEO_DURATION_SECONDS=21600
# WHISPER_CHUNK_SECONDS=600
# WHISPER_MAX_DURATION_SECONDS=300   # 3h locally, 5min by default on Vercel
# HOST=0.0.0.0
# PORT=8000
