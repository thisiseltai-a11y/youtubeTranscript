# Required for the "Rewrite with Claude" feature.
ANTHROPIC_API_KEY=

# Optional. Enables the Whisper fallback for videos with no captions, or
# only low-quality auto-generated ones. Without this, the tool still works
# but falls back to YouTube's auto-captions (or errors) when there's no
# human-made caption track.
OPENAI_API_KEY=

# Optional overrides - defaults shown.
# REWRITE_MODEL=claude-opus-5
# WHISPER_MODEL=whisper-1
# MAX_VIDEO_DURATION_SECONDS=21600
# WHISPER_CHUNK_SECONDS=600
# HOST=0.0.0.0
# PORT=8000
